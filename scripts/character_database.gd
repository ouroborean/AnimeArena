static func by_universe(exclude_path=""):
	var universe_dict = {}
	for concept in CharacterConcept.Universe:
		universe_dict[CharacterConcept.Universe[concept]] = []
	var characters = get_characters()
	for character in characters:
		if character.path_name != exclude_path:
			universe_dict[character.universe].append(character.path_name)
		# get_characters() instantiates the WHOLE roster (~226 scene subtrees,
		# 2000+ nodes) just to read path_name/universe — free every instance or
		# each bounty generation leaks all of them.
		character.queue_free()
	return universe_dict
