class_name EffectType

enum Type {
	SHIELD,
	DAMAGE,
	PRIMARY_STAT_MOD,
	DAMAGE_MOD,
	DAMAGE_REDUCTION,
	HEALING,
	STUN,
	STUN_IMMUNITY,
	INVULN,
	DEF_NEGATE,
	DAMAGE_NEGATE,
	DAMAGE_DEALT_TRIGGER,
	HARMFUL_USE_TRIGGER,
	HEALING_GIVEN_TRIGGER,
	HEALING_RECEIVED_TRIGGER,
	HELPFUL_USE_TRIGGER,
	ACTION_USE_TRIGGER,
	ACTION_RECEIVE_TRIGGER,
	HARMFUL_RECEIVE_TRIGGER,
	DAMAGE_RECEIVE_TRIGGER,
	HELPFUL_RECEIVE_TRIGGER,
	END_OF_TURN_TRIGGER,
	START_OF_TURN_TRIGGER,
	ON_DEATH_TRIGGER,
	STUN_RECEIVED_TRIGGER,
	MARK,
	UNIQUE,
	PAYLOAD_SWAP,
	COST_CHANGE,
	COST_MOD,
	TARGET_CHANGE,
	PASSIVE,
	COUNTER_USE,
	COUNTER_RECEIVE,
	COUNTER_TRIGGER_NOTIFICATION,
	REFLECT_RECEIVE,
	REFLECT_USE,
	INVISIBLE_EXPIRATION,
	HEALING_MOD,
	DAMAGE_REDIRECT,
	ABSORB_TRIGGER,
	VULNERABILITY,
	IGNORE_EFFECT,
	IGNORE_DAMAGE,
	IGNORE_HEALING,
	IGNORE_NON_DAMAGE,
	IGNORE_COUNTER,
	ERZA_ARMOR,
	BARRIER,
	MISSION_TRIGGER_GAME_END,
	MISSION_TRIGGER_ON_KILL,
	MISSION_TRIGGER_ON_USE,
	MISSION_TRIGGER_ON_HEAL,
	MISSION_TRIGGER_ON_DAMAGE,
	MISSION_TRIGGER_ON_EXECUTE,
	MISSION_TRIGGER_ON_STUN,
	MISSION_TRIGGER_ON_COUNTER,
	MISSION_TRIGGER_ON_IGNORE,
	MISSION_TRIGGER_ON_NEGATE_HEALING,
	MISSION_TRIGGER_ON_GAIN_ENERGY,
	MISSION_TRIGGER_ON_DRAIN_ENERGY,
	MISSION_TRIGGER_ON_CONSUME_STACKS,
	MISSION_TRIGGER_ON_END_TURN,
	MISSION_TRIGGER_ON_DESTROY_SHIELD,
	MISSION_TRIGGER_ON_TRIGGER_EFFECT,
	MISSION_TRIGGER_ON_PREVENT_DEATH,
	MISSION_TRIGGER_ON_SHIELD,
	MISSION_TRIGGER_ON_INVULN,
	MISSION_TRIGGER_ON_BLIND,
	MISSION_TRIGGER_ON_TAUNT,
	MISSION_TRIGGER_ON_SHATTER,
	MISSION_TRIGGER_ON_NULLIFY,
	MISSION_TRIGGER_ON_DR_ABSORB,
	MISSION_TRIGGER_ON_WEAKNESS_ABSORB,
	MISSION_TRIGGER_ON_SILENCE,
	DAMAGE_NULLIFICATION,
	BLIND,
	COOLDOWN_MOD,
	ABILITY_SWAP,
	TICKING_TRIGGER,
	PERCENT_DR,
	HEALTH_CHANGE_TRIGGER,
	DELAY,
	DELAYED_SKILL,
	EMPTY,
	COLOR_CHANGE,
	PORTRAIT_CHANGE,
	SILENCE,
	DAMAGE_REVERSE,
	STEALTH,
	CURSE,
	ISOLATE,
	MISS_CHANCE,
	DODGE_CHANCE,
	IMMORTALITY,
	TAUNT,
	SKILL_COPY,
	PARALYZE,
	CONTROL_CANCEL,
	CHANNEL_CANCEL,
	FALSE_STUN,
	SHARPSHOOTER,
	HEAL_CUT,
	CHAIN_NULLIFY,
	DAMAGE_CAP,
	HEALTH_CAP,
	BANISH,
	XANXUS_STORAGE,
	HEALING_RECEIVED_MOD,
	NAGISA_DR,
	DELAY_TICK_TRIGGER,
	DELAY_RECEIVE,
	DELAY_MARKER,
	DISGUISE,
	IGNORE_SKILL,
	HISOKA_HEALTH_FREEZE,
	DAMAGE_CAP_RECEIVE,
	IGNORE_CLEANSE,
	# Stuns a character's skills based on their resolved ENERGY COST rather than
	# their ability class (Fushiguro Toji's Split Soul Katana). `cost_change_element`
	# holds the Energy.Type that is stunned; is_stunned() checks ability.cost().
	# Appended at the end of the enum so existing wire/int values are unchanged.
	COST_STUN,
	# Trap of Argalia (Astolfo): while present on a character, that character cannot INCREASE the
	# damage it deals with any effect. can_boost() returns false and get_true_damage skips positive
	# DAMAGE_MOD boosts. Appended at the end so existing wire/int values are unchanged.
	NO_BOOST,
	# Summon - Igris (Sung Jin-woo): a hostile watcher holding this reacts whenever an ENEMY becomes
	# Invulnerable (dealing Piercing damage to them). Fired from apply_effect's INVULN branch via
	# check_invuln_received_triggers. Appended at the end so existing wire/int values are unchanged.
	INVULN_RECEIVED_TRIGGER
}

static func silenced_effects():
	return [
		EffectType.Type.SHIELD,
		EffectType.Type.DAMAGE_MOD,
		EffectType.Type.DAMAGE_REDUCTION,
		EffectType.Type.DAMAGE_NULLIFICATION,
		EffectType.Type.DELAY,
		EffectType.Type.SILENCE,
		EffectType.Type.BLIND,
		EffectType.Type.COOLDOWN_MOD,
		EffectType.Type.VULNERABILITY,
		EffectType.Type.INVULN,
		EffectType.Type.BARRIER,
		EffectType.Type.COST_MOD,
		EffectType.Type.IGNORE_HEALING,
		EffectType.Type.IGNORE_DAMAGE,
		EffectType.Type.IGNORE_NON_DAMAGE,
		EffectType.Type.IGNORE_EFFECT,
		EffectType.Type.PERCENT_DR,
		EffectType.Type.STUN,
		EffectType.Type.COST_STUN,
		EffectType.Type.DEF_NEGATE,
		EffectType.Type.DAMAGE_NEGATE,
		EffectType.Type.PERCENT_DR,
		EffectType.Type.STUN_IMMUNITY
	]
	
