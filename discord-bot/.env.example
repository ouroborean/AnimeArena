# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
#
#   cp .env.example .env    &&    chmod 600 .env

# --- REQUIRED -----------------------------------------------------------------
# Your bot token from https://discord.com/developers/applications
# (Application -> Bot -> Reset Token -> Copy). This is a SECRET.
DISCORD_TOKEN=paste-your-bot-token-here

# --- OPTIONAL -----------------------------------------------------------------
# Application ID (Developer Portal -> General Information). NOT a secret. Only used to
# print your bot's invite link on startup; discord.py otherwise derives it from the token.
DISCORD_APP_ID=

# Register slash commands to ONE server instantly (great while testing).
# Leave blank for a global sync (works everywhere, but takes up to ~1h the first time).
# Right-click your server -> Copy Server ID (needs Developer Mode on in Discord settings).
DISCORD_GUILD_ID=

# NOTE: your app's "Public Key" is NOT used by this bot. It only matters for the HTTP
# Interactions Endpoint model; a gateway bot (this one) receives interactions over its
# WebSocket, so there is no field for it here.

# Where the game's data files live. In the dev repo the bot reads them fresh; on the VM the
# JSON is bundled into discord-bot/data/ by deploy-bot.ps1 (the VM has no loose game files),
# so you normally do NOT need to set this.
# AA_GAME_DIR=/home/team.anima.arena

# The game server's WebSocket JSON gateway. Default assumes same VM as the game.
# AA_GATEWAY_URL=ws://localhost:5695

# Base URL that serves the game's /assets/ — enables ability + character images in embeds.
# The images are hosted on your Cloudflare Pages site, so point this at that origin (the bot
# appends /assets/images/...). Leave blank to omit images.
AA_ASSET_BASE_URL=https://anime-arena.live
AA_ASSET_VERSION=2026-08-23

# Path to the game server's stats.db on the VM (for /pickrate). The server writes it to its own
# working directory, so this usually differs from AA_GAME_DIR. Find it on the box with:
#   find /home /opt /srv /root -name stats.db 2>/dev/null
# Leave unset to disable /pickrate (it defaults to <AA_GAME_DIR>/stats.db, which is only right locally).
# AA_STATS_DB=/home/you/game/stats.db
